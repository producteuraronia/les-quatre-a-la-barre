---
export const prerender = true;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/fr/accueil" />
    <title>Redirection…</title>

    <script>
      // Détection simple côté client
      const lang = navigator.language || navigator.userLanguage || "";
      const isFrench = lang.toLowerCase().startsWith("fr");
      window.location.href = isFrench ? "/fr/accueil" : "/en/home";
    </script>
  </head>
  <body>
    Redirection…
  </body>
</html>
